{% import 'macros/macros' as macros %}
{% if styles %}
    {# There are background colors - do the wrapper with the background colors #}
    <div class="Wrapper{{ macros.blockMargin(margin) }}{{ macros.blockPadding(padding) }}"{{ styles.cssStylesAttribute }}{{ styles.themeEditorDataAttribute }}>
        <div class="Container Container--pad{{ macros.blockWidth(width) }}">
            <div class="clearfix">{{ content }}</div>
        </div>
    </div>
{% else %}
    <div class="Container Container--pad{{ macros.blockMargin(margin) }}{{ macros.blockPadding(padding) }}{{ macros.blockWidth(width) }}">
        <div class="clearfix">{{ content }}</div>
    </div>
{% endif %}
