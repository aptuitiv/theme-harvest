{% extends 'narrow' %}

{% block banner %}
    {% set heading = 'My Account' %}
    {% set content = '<p>' ~ account.firstName ~ ' ' ~ account.lastName ~ '</p>' %}
    {% include('blocks/banner') %}
{% endblock %}

{% block main %}
    <div class="text-center">
        <p><a href="{{ appUrls.edit }}">Edit My Account</a></p>
        <p><a href="{{ appUrls.logout }}">Log Out</a></p>
    </div>
{% endblock %}
